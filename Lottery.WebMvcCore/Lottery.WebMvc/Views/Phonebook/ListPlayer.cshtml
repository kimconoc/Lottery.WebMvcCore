@using Lottery.DoMain.Constant;
@using Lottery.DoMain.Models;
@using Newtonsoft.Json;
@using Lottery.DoMain.Enum;
@using Lottery.Service.ServiceProvider;
@using Lottery.Service.ServiceProvider.Interface;
@using Lottery.WebMvc.MemCached.Interface;
@inject IProvider provider
@inject IMemCached memCached
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Phonebook> phonebooks = new List<Phonebook>();
    User user = memCached.GetCurrentUser();
    if (user != null)
    {
        var dataBase = provider.GetAsync<List<Phonebook>>(string.Format(ApiUri.Get_Phonebook + "/{0}", user.Id));
        if (dataBase != null && dataBase.Result != null && dataBase.Result.Data != null)
        {
            phonebooks = dataBase.Result.Data;
        }
    }
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link href="~/css/listPlayer.css?v=@Default.VersionApp" rel="stylesheet" />
    <style>

    </style>
</head>
<body>
    <div class="container-listplayer">
        <div class="info-page">
            <strong>
                Danh Bạ
            </strong>
        </div>
        @{
            if (phonebooks == null || phonebooks.Count == 0)
            {
                <div class="box-no-data-found">
                    <img src="~/lottery/empty-order/empty-order.png">
                    <span>Không có danh bạ</span>
                </div>
            }
            else
            {
                foreach (var item in phonebooks)
                {
                    <div class="div-list-player">
                        <div class="avatar">
                            <i class="fa fa-user-circle"></i>
                        </div>
                        <div style="flex: 1;">
                            <div class="info-detail">
                                <strong style="font-size:18px;">@string.Format(item.Name)</strong>
                                <span style="margin-top:5px;">@string.Format(item.PhoneNumber + " " + (item.IsChu? "(chủ)" : "(khách)"))</span>
                            </div>
                            @{
                                if (item.NoCu < 0)
                                {
                                    <div onclick="openPopup('@item.Id', '@item.NoCu')" class="debt">
                                        <span>Lời :</span>
                                        <strong style="color:red">@item.NoCu</strong>
                                    </div>
                                }
                                else
                                {
                                    <div onclick="openPopup('@item.Id', '@item.NoCu')" class="debt">
                                        <span>Nợ :</span>
                                        <strong style="color:blue">@item.NoCu</strong>
                                    </div>
                                }
                            }
                            <i id="@item.Id" onclick="deletePlayer(this)" class="icon-danger-delete fa fa-trash" aria-hidden="true"></i>
                            <i onclick="window.location.href='/Phonebook/ExecutionPlayer?playerId=@item.Id&isCopy=true';" class="icon-danger-copy fa fa-clone" aria-hidden="true"></i>
                            <i onclick="window.location.href='/Phonebook/ExecutionPlayer?playerId=@item.Id';" class="icon-danger-info fa fa-pencil-square-o" aria-hidden="true"></i>
                            <div style="margin-bottom:20px;" class="border-bottom-row"></div>
                        </div>
                    </div>
                }
            }
        }  

        <!-- ===== Overlay Popup ===== -->
        <div id="popupDebt" class="popup-overlay">

            <div class="popup-box">

                <div class="popup-header">
                    Cập nhật nợ cũ
                    <span onclick="closePopup()" class="close-btn">&times;</span>
                </div>

                <div class="popup-body">

                    <label>Số tiền</label>
                    <input id="txtDebt" type="number" placeholder="Nhập số tiền..." />

                    <div class="btn-group">
                        <button onclick="submitDebt('no')" class="btn btn-no">Nợ</button>
                        <button onclick="submitDebt('loi')" class="btn btn-loi">Lời</button>
                    </div>

                </div>

            </div>

        </div>

    </div>
    <script>
        function deletePlayer(dom) {
            if (confirm("Bạn muốn xóa người chơi này?")) {
                executeConfirm(dom.id);
            }
        }

        function executeConfirm(playerId) {
            ShowOverlay(true);
            $.ajax({
                type: "POST",
                traditional: true,
                data:
                {
                    "playerId": playerId,
                },
                url: "@Url.Action("ExecuteDeletePlayer", "Phonebook")",
                success: function (data) {
                    hideOverlay();
                    if (data.success && data.data) {
                        awesomeAlert({
                            header: true,
                            type: 'success',
                            title: 'Thành công!',
                            message: 'Xóa người chơi thành công.',
                            //bgColor: '#2dd284',
                            img: '/assets/images/icon/success.svg',
                            buttonOK: 'Xong!',
                            closeStyle: 'circle'
                        }).then(res => window.location = "/Phonebook/ListPlayer")
                    }
                    else {
                        if (data.redirectTo) {
                            // Chuyển hướng trình duyệt đến đường dẫn được chỉ định
                            window.location.href = data.redirectTo;
                        } else {
                            var message = "Đã có lỗi xảy ra."
                            if (!isNullOrEmpty(data.message)) {
                                message = data.message;
                            }
                            awesomeAlert({
                                header: true,
                                type: 'error',
                                title: 'Có lỗi!',
                                message: message,
                                //bgColor: '#2dd284',
                                img: '/assets/images/icon/error.svg',
                                buttonOK: 'Oke!',
                                closeStyle: 'circle'
                            }).then(res => false)
                        }
                    }
                },
            })
        }

        function openPopup(playerId, oldDebt) {

            document.getElementById("popupDebt").style.display = "flex";

            // lưu ID khách đang sửa
            window.currentPlayer = playerId;

            // lưu nợ cũ
            window.currentOldDebt = oldDebt ?? 0;

            // gán mặc định vào ô nhập tiền
            document.getElementById("txtDebt").value = window.currentOldDebt;

            // nếu có label hiển thị nợ cũ thì set luôn
            let lbl = document.getElementById("oldDebtLabel");
            if (lbl) {
                lbl.innerText = "Nợ cũ: " + window.currentOldDebt;
            }
        }

        function closePopup() {
            document.getElementById("popupDebt").style.display = "none";
        }

        function submitDebt(type) {

            let amount = document.getElementById("txtDebt").value;

            if (!amount) {
                return;
            }

            // ===== chuẩn hóa dấu =====
            if (type === 'no') {          // NỢ
                amount = Math.abs(amount);
            }
            else if (type === 'loi') {    // LỜI
                amount = -Math.abs(amount);
            }
            
            ShowOverlay(true);
            $.ajax({
                type: "POST",
                traditional: true,
                data:
                {
                    "idKhach": window.currentPlayer,
                    "noCu": amount,
                },
                url: "@Url.Action("ExecuteUpdateNo", "Phonebook")",
                success: function (data) {
                    hideOverlay();
                    if (data.success && data.data) {
                        awesomeAlert({
                            header: true,
                            type: 'success',
                            title: 'Thành công!',
                            message: 'Cập nhật nợ thành công.',
                            //bgColor: '#2dd284',
                            img: '/assets/images/icon/success.svg',
                            buttonOK: 'Xong!',
                            closeStyle: 'circle'
                        }).then(res => window.location = "/Phonebook/ListPlayer")
                    }
                    else {
                        if (data.redirectTo) {
                            // Chuyển hướng trình duyệt đến đường dẫn được chỉ định
                            window.location.href = data.redirectTo;
                        } else {
                            var message = "Đã có lỗi xảy ra."
                            if (!isNullOrEmpty(data.message)) {
                                message = data.message;
                            }
                            awesomeAlert({
                                header: true,
                                type: 'error',
                                title: 'Có lỗi!',
                                message: message,
                                //bgColor: '#2dd284',
                                img: '/assets/images/icon/error.svg',
                                buttonOK: 'Oke!',
                                closeStyle: 'circle'
                            }).then(res => false)
                        }
                    }
                },
            })

            closePopup();
        }

    </script>
</body>
</html>