@using Lottery.DoMain.Constant;
@using Lottery.DoMain.Enum;
@using Lottery.DoMain.Extentions;
@using Lottery.DoMain.Models;
@using Lottery.WebMvc.MemCached.Interface;
@inject IMemCached memCached
@inject IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.LayoutCenterTitle = "Thiết lập";
    User user = memCached.GetCurrentUser();
    if (user == null || !user.IsAdmin)
    {
        HttpContextAccessor.HttpContext.Response.Redirect("/Account/Login");
    }
    var isAllowCal = ViewBag.IsAllowCal as bool? ?? true;
}

<link href="~/css/extendExpireDate.css?v=@Default.VersionApp" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/assets/helpers/datetimepicker-master/jquery.datetimepicker.css" />
<script src="~/assets/helpers/datetimepicker-master/jquery.datetimepicker.full.min.js"></script>
<style>
    .container-settings {
        padding: 10px;
    }

    .settings-section-title {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .settings-divider {
        border-top: 1px solid #e0e0e0;
        margin: 16px 0;
    }

    .wrapper form .row select {
        font-size: 15px;
        height: 100%;
        width: 100%;
        outline: none;
        border-radius: 5px;
        border: 1px solid lightgrey;
        padding: 0 5px;
        background-color: #fff;
    }

    .wrapper form .row input[type="submit"]:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .xdsoft_datetimepicker {
        left: 50% !important;
        top: 250px !important;
        margin-left: -120px !important;
    }

    .settings-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 0;
        font-size: 16px;
    }

    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 52px;
        height: 28px;
        flex-shrink: 0;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .3s;
        border-radius: 28px;
    }

    .toggle-slider:before {
        position: absolute;
        content: "";
        height: 22px;
        width: 22px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
    }

    .toggle-switch input:checked + .toggle-slider {
        background-color: #2dd284;
    }

    .toggle-switch input:checked + .toggle-slider:before {
        transform: translateX(24px);
    }

    .settings-note {
        font-size: 13px;
        color: #666;
        margin-top: 8px;
        line-height: 1.4;
    }
</style>

<div class="container-settings">
    <div class="wrapper div-form-account">
        <div class="icon-account">
            <i class="fa fa-cog" aria-hidden="true"></i>
        </div>
        <div class="settings-row">
            <span>Cho phép cập nhật kết quả</span>
            <label class="toggle-switch">
                <input type="checkbox" id="allow_cal_toggle" @(isAllowCal ? "checked" : "")>
                <span class="toggle-slider"></span>
            </label>
        </div>
        <div class="settings-note">
            Khi tắt, hệ thống sẽ không cập nhật kết quả trúng trong ngày hiện tại.
        </div>

        <div class="settings-divider"></div>

        <div class="settings-section-title">Update toàn bộ trúng thưởng</div>
        <form id="updateAllWinningForm">
            <div class="div-row-input-val">
                <div class="row row-input-val">
                    <span>Ngày cập nhật:</span>
                    <input style="cursor:pointer;" tabindex="1" readonly id="update_all_date_display" placeholder="Chọn ngày" value="">
                </div>
            </div>
            <div class="div-row-input-val">
                <div class="row row-input-val">
                    <span>Miền:</span>
                    <select tabindex="2" id="update_all_region" required>
                        <option value="">Lựa chọn miền</option>
                        <option value="@((int)RegionEnum.MienNam)">@RegionEnum.MienNam.GetDescription()</option>
                        <option value="@((int)RegionEnum.MienTrung)">@RegionEnum.MienTrung.GetDescription()</option>
                        <option value="@((int)RegionEnum.MienBac)">@RegionEnum.MienBac.GetDescription()</option>
                    </select>
                </div>
            </div>
            <div class="div-row-input-val">
                <div class="row row-input-val">
                    <input type="submit" tabindex="3" id="btn_update_all_winning" value="Cập nhật" disabled>
                </div>
            </div>
        </form>
        <div class="settings-note">
            Cập nhật lại toàn bộ kết quả trúng thưởng theo ngày và miền đã chọn.
        </div>
    </div>
    <input id="update_all_day" style="display:none;" type="text">
    <div id="datepicker_open_update_all"></div>
</div>

<script>
    var previousAllowCal = @isAllowCal.ToString().ToLower();
    var updateAllSelectedDate = '';

    $(document).ready(function () {
        validateUpdateAllForm();
    });

    jQuery.datetimepicker.setLocale('vi');
    jQuery('#update_all_day').datetimepicker({
        timepicker: false,
        value: '@DateTime.Now.ToString("yyyy/MM/dd HH:mm")',
        onShow: function () {
            document.getElementById("datepicker_open_update_all").classList.add("datepicker-open");
        },
        onClose: function () {
            document.getElementById("datepicker_open_update_all").classList.remove("datepicker-open");
        }
    });

    $('#update_all_date_display').on('click', function () {
        $('#update_all_day').datetimepicker('show');
    });

    $('#update_all_day').on('change', function () {
        var dateString = $(this).val();
        var dateParts = dateString.split(' ')[0].split('/');
        var displayDate = dateParts[2] + '/' + dateParts[1] + '/' + dateParts[0];
        updateAllSelectedDate = dateString;
        $('#update_all_date_display').val(displayDate);
        validateUpdateAllForm();
    });

    $('#update_all_region').on('change', function () {
        validateUpdateAllForm();
    });

    function validateUpdateAllForm() {
        var hasDate = updateAllSelectedDate !== '';
        var hasRegion = $('#update_all_region').val() !== '';
        $('#btn_update_all_winning').prop('disabled', !(hasDate && hasRegion));
    }

    document.getElementById("updateAllWinningForm").addEventListener("submit", function (event) {
        event.preventDefault();
        var region = $('#update_all_region').val();
        var regionText = $('#update_all_region option:selected').text();
        var displayDate = $('#update_all_date_display').val();

        if (!updateAllSelectedDate || region === '') {
            return;
        }

        if (!confirm(`Bạn muốn cập nhật toàn bộ trúng thưởng ngày ${displayDate} cho ${regionText}?`)) {
            return;
        }

        ShowOverlay(true);
        $.ajax({
            type: "POST",
            data: {
                date: updateAllSelectedDate,
                region: region
            },
            url: "@Url.Action("UpdateAllWinning", "Main")",
            success: function (data) {
                if (data.success && data.data) {
                    awesomeAlert({
                        header: true,
                        type: 'success',
                        title: 'Thành công!',
                        message: 'Cập nhật thành công.',
                        img: '/assets/images/icon/success.svg',
                        buttonOK: 'Xong!',
                        closeStyle: 'circle'
                    }).then(res => false);
                }
                else {
                    if (data.redirectTo) {
                        window.location.href = data.redirectTo;
                    } else {
                        awesomeAlert({
                            header: true,
                            type: 'warning',
                            title: 'Cảnh báo!',
                            message: 'Cập nhật thất bại.',
                            img: '/assets/images/icon/warning.svg',
                            buttonOK: 'Oke!',
                            closeStyle: 'circle'
                        }).then(res => false);
                    }
                }
            },
            error: function () {
                awesomeAlert({
                    header: true,
                    type: 'error',
                    title: 'Có lỗi!',
                    message: 'Lỗi hệ thống',
                    img: '/assets/images/icon/error.svg',
                    buttonOK: 'Oke!',
                    closeStyle: 'circle'
                }).then(res => false);
            },
            complete: function () {
                hideOverlay();
            }
        });
    });

    $('#allow_cal_toggle').on('change', function () {
        var toggle = $(this);
        var newValue = toggle.is(':checked');
        var message = newValue
            ? 'Bạn có chắc muốn bật cho phép cập nhật kết quả?'
            : 'Bạn có chắc muốn tắt cho phép cập nhật kết quả?';

        if (!confirm(message)) {
            toggle.prop('checked', previousAllowCal);
            return;
        }

        ShowOverlay(true);
        $.ajax({
            type: "POST",
            data: { isAllowCal: newValue },
            url: "@Url.Action("UpdateAllowCal", "Main")",
            success: function (data) {
                if (data.success) {
                    previousAllowCal = newValue;
                    awesomeAlert({
                        header: true,
                        type: 'success',
                        title: 'Thành công!',
                        message: newValue ? 'Đã bật cho phép cập nhật kết quả.' : 'Đã tắt cho phép cập nhật kết quả.',
                        img: '/assets/images/icon/success.svg',
                        buttonOK: 'Xong!',
                        closeStyle: 'circle'
                    }).then(res => false);
                }
                else {
                    toggle.prop('checked', previousAllowCal);
                    if (data.redirectTo) {
                        window.location.href = data.redirectTo;
                    } else {
                        awesomeAlert({
                            header: true,
                            type: 'warning',
                            title: 'Cảnh báo!',
                            message: data.message || 'Cập nhật thất bại.',
                            img: '/assets/images/icon/warning.svg',
                            buttonOK: 'Oke!',
                            closeStyle: 'circle'
                        }).then(res => false);
                    }
                }
            },
            error: function () {
                toggle.prop('checked', previousAllowCal);
                awesomeAlert({
                    header: true,
                    type: 'error',
                    title: 'Có lỗi!',
                    message: 'Lỗi hệ thống',
                    img: '/assets/images/icon/error.svg',
                    buttonOK: 'Oke!',
                    closeStyle: 'circle'
                }).then(res => false);
            },
            complete: function () {
                hideOverlay();
            }
        });
    });
</script>
